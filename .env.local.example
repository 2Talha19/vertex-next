# Copy to ".env.local"  →  Copy-Item .env.local.example .env.local
# SERVER ONLY — never commit real keys.

GROQ_API_KEY=
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
JINA_API_KEY=
GEMINI_API_KEY=

# --- Auth (email verification + password reset via Supabase Auth — uses SUPABASE_URL + SUPABASE_SERVICE_ROLE_KEY above) ---
# EMAIL SENDING — two options:
# 1. RESEND_API_KEY (recommended): verification codes are emailed via Resend's API
#    (free tier: 100 emails/day, vs ~2/hour on Supabase's built-in provider). Get a
#    free key at https://resend.com → API Keys. No Supabase dashboard changes needed.
RESEND_API_KEY=
RESEND_FROM=          # optional sender; default "Vertex <onboarding@resend.dev>" (test-only —
                      # only reaches your own Resend account email until you verify a domain)
# 2. No key: falls back to Supabase's built-in email (~2/hour). For higher limits via SMTP
#    instead, add a provider in Supabase → Authentication → SMTP settings (e.g. SMTP2GO 200/day).

# --- OCR (all optional — image OCR cascade: Gemini → Groq → HF → local Python) ---
GEMINI_OCR_MODEL=      # default gemini-2.5-flash
GROQ_OCR_MODEL=        # default qwen/qwen3.6-27b (multimodal, free tier)
HF_TOKEN=              # optional: enables Hugging Face Qwen2.5-VL OCR (credit-limited free tier)
HF_OCR_MODEL=          # default Qwen/Qwen2.5-VL-7B-Instruct

# The emailed confirmation link normally points at the Supabase dashboard's "Site URL"
# (default http://localhost:3000). To make it point at the app wherever it runs (any port,
# any host), the app auto-detects the URL from the request — or set AUTH_REDIRECT_URL to
# override it (e.g. https://your-app.com). The URL must be listed in
# Supabase → Authentication → URL Configuration → Redirect URLs (wildcard allowed,
# e.g. http://localhost:**/** for any localhost port). If it isn't, the code still gets
# emailed; only the link falls back to the Site URL.
AUTH_REDIRECT_URL=

# --- SMTP email sending (RECOMMENDED — replaces the 2/hour Supabase limit) ---
# Any SMTP relay works (Brevo, Gmail, SMTP2GO, MailerSend, …). Example (Brevo
# free: 300 emails/day, no domain needed, no credit card):
#   SMTP_HOST="smtp-relay.brevo.com"
#   SMTP_PORT=587
#   SMTP_SECURE=false
#   SMTP_USER="<your brevo login email>"
#   SMTP_PASS="<your SMTP key>"
#   SMTP_FROM="Vertex <you@example.com>"   # must be a verified sender in the provider
# Gmail example: SMTP_HOST="smtp.gmail.com", SMTP_PORT=465, SMTP_SECURE=true,
# SMTP_USER=<your gmail>, SMTP_PASS=<app password> (needs 2-Step Verification).
# When SMTP is set, codes are emailed to ANY address (code + clickable link),
# with no per-hour cap. Falls back to Resend (if RESEND_FROM set), then to
# Supabase's built-in email (~2/hour, last resort).
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
